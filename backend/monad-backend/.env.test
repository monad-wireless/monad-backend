# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Integration tests need a real PostgreSQL: the ground-truth idempotency guarantee is a UNIQUE
# index, and a unique index is exactly the thing an in-memory double cannot have. Doctrine's
# `when@test` config appends `_test`, so this points the suite at `monad_db_test` on the local
# dev stack (`docker compose up postgres`, published on 55432 per .env).
#
# A real environment variable wins over this file, which is how CI aims the same suite at its own
# throwaway postgres service.
DATABASE_URL="postgresql://monad_user:localdev@127.0.0.1:55432/monad_db?serverVersion=16&charset=utf8"

# Matches the committed local-dev keypair in config/jwt, so a kernel boot in the test env does not
# fail on an unreadable key.
JWT_PASSPHRASE='localdevjwt'
DEFAULT_URI='http://localhost'
CORS_ALLOW_ORIGIN='^https?://localhost$'

# IP-157 — Messenger in tests never reaches a broker or a table: messages stay in memory and a
# test asserts on them. The three MONAD_* values are the same inert defaults as .env.
MESSENGER_TRANSPORT_DSN='in-memory://'
MONAD_FCM_CREDENTIALS=''
MONAD_BETA_RETENTION_DAYS=90
MONAD_PUBLIC_SITE_URL='https://monad.dubec.dev'

# Object storage is never touched by the test suite; these exist only so the container compiles.
HETZNER_S3_ENDPOINT='https://example.invalid'
HETZNER_S3_USE_PATH_STYLE=1
HETZNER_S3_REGION='fsn1'
HETZNER_S3_BUCKET='test'
HETZNER_S3_ACCESS_KEY='test'
HETZNER_S3_SECRET_KEY='test'
HETZNER_S3_PRESIGNED_URL_EXPIRY='+15 minutes'
