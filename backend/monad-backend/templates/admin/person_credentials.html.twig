{% extends '@EasyAdmin/page/content.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{#
  The one place a generated password is visible (2026-11-23). This page is the POST response
  that set it, served private + no-store; only the hash is stored. Nothing on it is fetched again.
#}

{% block content_title %}Invitation for {{ person.name ?? person.email }}{% endblock %}
{% block breadcrumb %}<a href="{{ path('admin_people') }}">People</a>{% endblock %}
{% block page_actions %}<a class="ui-btn" href="{{ path('admin_participant', {id: person.id}) }}">Open person</a>{% endblock %}

{% block main %}
    <div class="credentials">
        <p class="ui-note"><strong>{{ done }}</strong> The password below is shown only on this page. It is not stored in readable form. If you lose it, use "New password + invitation" on the person page.</p>

        {{ ui.kv([
            {label: 'Sign-in e-mail', value: '<code>' ~ person.email|e ~ '</code>'},
            {label: 'Password', value: '<code class="credential-password">' ~ password|e ~ '</code>'},
        ]) }}

        <div class="invitation-compose" data-invitation>
            <label for="inv-to">To</label>
            <input id="inv-to" type="text" value="{{ person.email }}" readonly>
            <label for="inv-subject">Subject</label>
            <input id="inv-subject" type="text" value="{{ subject }}">
            <label for="inv-body">Message (edit before sending if you like)</label>
            <textarea id="inv-body" rows="24">{{ body }}</textarea>
            <div class="row-actions">
                <a class="ui-btn ui-btn-primary" href="#" data-mailto>Open in Mail</a>
                <button type="button" class="ui-btn" data-copy>Copy message</button>
                <a class="ui-btn" download="monadcount-invitation.eml" href="data:message/rfc822;base64,{{ eml }}">Download .eml</a>
                <span class="text-muted" data-copy-status aria-live="polite"></span>
            </div>
        </div>

        <aside class="invitation-help">
            <strong>Sending</strong>
            <p><strong>Open in Mail</strong> starts a new message in your default mail app with the text above, including your edits. The .eml download holds the original text; in Apple Mail open it and choose Message → Send Again (⇧⌘D).</p>
            <p>Nothing is sent from this server. <strong>Do not reload this page.</strong> After a new account, a reload only returns to the person page. After "New password + invitation", a reload sets another password and the one shown here stops working.</p>
        </aside>
    </div>
    <script>
        (function () {
            var box = document.querySelector('[data-invitation]');
            if (!box) return;
            var to = box.querySelector('#inv-to'), subject = box.querySelector('#inv-subject'), body = box.querySelector('#inv-body');
            box.querySelector('[data-mailto]').addEventListener('click', function (event) {
                event.preventDefault();
                window.location.href = 'mailto:' + encodeURIComponent(to.value) + '?subject=' + encodeURIComponent(subject.value) + '&body=' + encodeURIComponent(body.value);
            });
            box.querySelector('[data-copy]').addEventListener('click', function () {
                var status = box.querySelector('[data-copy-status]');
                navigator.clipboard.writeText(body.value).then(function () { status.textContent = 'Copied.'; }, function () { body.select(); status.textContent = 'Select-all done; press ⌘C.'; });
            });
        })();
    </script>
{% endblock %}
