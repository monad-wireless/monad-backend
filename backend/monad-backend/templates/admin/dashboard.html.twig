{% extends '@EasyAdmin/page/content.html.twig' %}
{% import 'admin/_macros.html.twig' as m %}

{# Two dense tables and two recent lists. Every number answers a question an operator asks
   mid-session; nothing here is a tile. #}

{% block content_title %}Overview{% endblock %}

{% block main %}
    <div class="strip">
        <span><span class="k">Fleet</span>
            {% if fleet.reachable %}
                {{ fleet.scalars.nodes_reporting is defined ? fleet.scalars.nodes_reporting|round : '?' }}/{{ fleet.scalars.nodes_expected is defined ? fleet.scalars.nodes_expected|round : '?' }} reporting,
                {{ fleet.scalars.nodes_delivering is defined ? fleet.scalars.nodes_delivering|round : '?' }} delivering CSI
                <a href="{{ path('admin_lab_fleet') }}">vitals</a>
            {% else %}
                <span class="state state-warn">metrics store unreachable</span>
            {% endif %}
        </span>
        <span><span class="k">Users</span>{{ counts.users }} ({{ counts.admins }} admin{{ counts.admins == 1 ? '' : 's' }})</span>
        <span><span class="k">Quests</span>{{ counts.quests }} <a href="{{ path('admin_lab_arming') }}">arming</a></span>
        <span><span class="k">Nodes</span>{{ counts.devices }}</span>
        {% set placement_mismatch = placement_mismatch_count() %}
        <span><span class="k">Placements</span>{% if placement_mismatch > 0 %}<span class="state state-bad">{{ placement_mismatch }} named, not mirrored</span>{% else %}<span class="state state-ok">mirror agrees</span>{% endif %} <a href="{{ path('admin_lab_placements') }}">board</a></span>
        <span><span class="k">Handsets</span>{{ counts.handsets }}</span>
        <span><span class="k">Scans</span>{{ counts.scans }}{% if counts.conflicts > 0 %}, <span class="state state-bad">{{ counts.conflicts }} conflicts (E3)</span>{% endif %}</span>
    </div>

    <div class="card mb-3">
        <div class="card-header">Activity</div>
        <div class="table-responsive">
            <table class="table table-sm table-dense mb-0">
                <thead>
                    <tr>
                        <th>Window</th>
                        <th class="num">Runs started</th>
                        <th class="num">Completed</th>
                        <th class="num">Abandoned</th>
                        <th class="num">Failed</th>
                        <th class="num">In progress</th>
                        <th class="num">Sessions uploaded</th>
                        <th class="num">Bytes</th>
                        <th class="num">Without sidecar</th>
                    </tr>
                </thead>
                <tbody>
                    {% for label, a in activity %}
                        <tr>
                            <td>{{ label }}</td>
                            <td class="num">{{ a.started }}</td>
                            <td class="num">{{ a.completed }}</td>
                            <td class="num">{{ a.abandoned }}</td>
                            <td class="num">{{ a.failed }}</td>
                            <td class="num">{{ a.in_progress }}</td>
                            <td class="num">{{ a.sessions }}</td>
                            <td class="num">{{ a.bytes|bytes }}</td>
                            <td class="num {{ a.incomplete > 0 ? 'state-warn' : '' }}">{{ a.incomplete }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="card-body pt-2 pb-2">
            <p class="text-muted small mb-0">
                "Without sidecar" counts sessions whose streams landed and whose <code>metadata.json</code> never
                arrived — an upload that stopped half way, not a session nobody ran. Sessions uploaded before
                2026-09-04 appear once <code>app:lab-sessions:backfill</code> has run.
            </p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Recent recording sessions</div>
        <div class="table-responsive">{{ m.session_rows(recent_sessions) }}</div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Recent enrollments</div>
        <div class="table-responsive">{{ m.enrollment_rows(recent_enrollments) }}</div>
    </div>

    <div class="card">
        <div class="card-header">Recent ground-truth sessions</div>
        <div class="table-responsive">
            <table class="table table-sm table-dense mb-0">
                <thead>
                    <tr><th>Ground-truth session</th><th class="num">Scans</th><th class="num">Participants</th><th>Last scan</th></tr>
                </thead>
                <tbody>
                    {% for session in recent_ground_truth %}
                        <tr>
                            <td><a href="{{ path('admin_lab_session', {labSessionId: session.lab_session_id}) }}"><code>{{ session.lab_session_id }}</code></a></td>
                            <td class="num">{{ session.scans }}</td>
                            <td class="num">{{ session.participants }}</td>
                            <td>{{ session.last_seen ? session.last_seen|clock : '—' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-muted">No ground truth yet. A session appears when its first check-in scan arrives.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
