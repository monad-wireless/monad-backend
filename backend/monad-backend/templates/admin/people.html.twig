{% extends '@EasyAdmin/page/content.html.twig' %}
{% import 'admin/_ui.html.twig' as ui %}

{#
  PEOPLE — one list over accounts and beta signups (2026-11-23). A signup without an account
  is a row with "Create account"; everything else opens the person page.
#}

{% block content_title %}People{% endblock %}
{% block page_actions %}
    <a class="ui-btn" href="{{ path('admin_people_onboarding_export') }}">Export signups CSV</a>
    <a class="ui-btn" href="{{ users_url }}">Raw account register</a>
{% endblock %}

{% block main %}
    {% set token = csrf_token('people') %}
    {% set signup_token = csrf_token('onboarding') %}
    {% set platforms = {ios: 'iPhone', android: 'Android', unsure: 'Not sure'} %}
    <div class="onboarding people-desk">
        <p class="ui-note"><strong>Create account</strong> makes an active account with a generated password and shows the invitation to send (TestFlight link, e-mail, password). The tester can change the password in the app.</p>

        {% set tabs = [] %}
        {% for key, label in stages %}
            {% set tabs = tabs|merge([{label: label, href: path('admin_people', {stage: key}), count: counts[key]}]) %}
        {% endfor %}
        {% set tabs = tabs|merge([{label: 'All', href: path('admin_people', {stage: 'all'}), count: total}]) %}
        {{ ui.tabs(tabs, stage == 'all' ? 'All' : stages[stage]) }}

        {{ ui.table_start([
            {label: 'Person', wrap: true},
            {label: 'Stage'},
            {label: 'Platform'},
            {label: 'Runs', align: 'right'},
            {label: 'Points', align: 'right'},
            {label: 'Last run activity'},
            {label: 'Since'},
            {label: 'Actions', wrap: true},
        ], {datatable: true, label: 'people', class: 'onboarding-table'}) }}
        {% for row in rows %}
            {% set u = row.user %}
            {% set s = row.signup %}
            {% set person_href = u ? path('admin_participant', {id: u.id}) : null %}
            <tr>
                <td class="wrap">
                    {% if u %}
                        {{ ui.identity(u.name ?? (s ? s.name : null), u.email, person_href) }}
                    {% elseif s.status.value == 'withdrawn' %}
                        <span class="text-muted">Personal details removed</span>
                    {% else %}
                        {{ ui.identity(s.name, s.email) }}
                    {% endif %}
                </td>
                <td>
                    {% if u %}
                        {% if u.deleted %}{{ ui.state('anonymised', 'muted') }}
                        {% elseif row.stage == 'pending' %}{{ ui.state('waiting for approval', 'warn') }}
                        {% elseif row.stage == 'closed' %}{{ ui.state(u.status.value, 'muted') }}
                        {% else %}{{ ui.state(row.stage == 'operator' ? 'operator' : 'active', 'ok') }}{% endif %}
                    {% else %}
                        {{ ui.state(s.status.value == 'new' ? 'signed up' : s.status.value, row.stage == 'awaiting' ? 'warn' : 'muted') }}
                    {% endif %}
                </td>
                <td>{{ s ? platforms[s.platform.value] : '—' }}</td>
                <td class="num" data-order="{{ row.runs ? row.runs.runs : 0 }}">{% if row.runs %}{{ row.runs.completed }} / {{ row.runs.runs }}{% if row.runs.open > 0 %} <span class="state state-muted">{{ row.runs.open }} open</span>{% endif %}{% else %}—{% endif %}</td>
                <td class="num" data-order="{{ row.runs ? row.runs.points : 0 }}">{{ row.runs ? row.runs.points|number_format(1) : '—' }}</td>
                <td data-order="{{ row.last_at ? row.last_at.timestamp : 0 }}">{{ row.last_at ? ui.clock(row.last_at) : '—' }}</td>
                <td data-order="{{ row.since.timestamp }}">{{ ui.clock(row.since) }}</td>
                <td class="wrap">
                    <div class="row-actions">
                        {% if row.stage == 'awaiting' %}
                            <form method="post" action="{{ path('admin_people_create_account', {id: s.id}) }}">
                                <input type="hidden" name="_token" value="{{ token }}">
                                <button type="submit" class="ui-btn ui-btn-primary">Create account</button>
                            </form>
                        {% elseif row.stage == 'pending' %}
                            <form method="post" action="{{ path('admin_people_access', {id: u.id}) }}">
                                <input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="status" value="active"><input type="hidden" name="stage" value="{{ stage }}">
                                <button type="submit" class="ui-btn ui-btn-primary">Approve</button>
                            </form>
                        {% endif %}
                        {% if person_href %}<a class="ui-btn" href="{{ person_href }}">Open</a>{% endif %}
                    </div>
                    {% if not u and s.status.value != 'withdrawn' %}
                        <details class="row-details signup-more">
                            <summary>{{ s.notes ? 'Notes & more' : 'Details & more' }}</summary>
                            <dl>
                                <dt>Availability</dt><dd>{{ {yes: 'Available', sometimes: 'Sometimes', remote: 'Remote only', no: 'Not available'}[s.availability.value] ?? s.availability.value }}</dd>
                                <dt>Updates</dt><dd>{{ s.updatesOptIn ? 'Opted in' : 'Not subscribed' }}</dd>
                                <dt>Source</dt><dd>{{ s.source ?? 'Not recorded' }}</dd>
                                {% if s.invitedAt %}<dt>Invited</dt><dd>{{ s.invitedAt|clock }}{% if s.invitedBy %}<br>{{ s.invitedBy.email }}{% endif %}</dd>{% endif %}
                            </dl>
                            <form method="post" action="{{ path('admin_people_onboarding_notes', {id: s.id}) }}" class="signup-notes">
                                <input type="hidden" name="_token" value="{{ signup_token }}"><input type="hidden" name="stage" value="{{ stage }}">
                                <label for="notes-{{ s.id }}">Private operator note</label>
                                <textarea id="notes-{{ s.id }}" name="notes" rows="3">{{ s.notes ?? '' }}</textarea>
                                <button type="submit" class="ui-btn">Save note</button>
                            </form>
                            <div class="row-actions">
                                {% if s.status.value in ['new', 'invited'] %}
                                    <form method="post" action="{{ path('admin_people_onboarding_decline', {id: s.id}) }}" data-confirm="Decline this signup? No email will be sent.">
                                        <input type="hidden" name="_token" value="{{ signup_token }}"><input type="hidden" name="stage" value="{{ stage }}"><button type="submit" class="ui-btn">Decline</button>
                                    </form>
                                {% endif %}
                                {% if s.status.value in ['new', 'invited', 'declined'] %}
                                    <form method="post" action="{{ path('admin_people_onboarding_withdraw', {id: s.id}) }}" data-confirm="Withdraw {{ s.email }}? Their email, name and notes will be permanently removed.">
                                        <input type="hidden" name="_token" value="{{ signup_token }}"><input type="hidden" name="stage" value="{{ stage }}"><button type="submit" class="ui-btn ui-btn-danger">Withdraw</button>
                                    </form>
                                {% endif %}
                            </div>
                        </details>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="8" class="wrap"><span class="ui-empty">Nobody in this stage. Choose another tab above.</span></td></tr>
        {% endfor %}
        {{ ui.table_end() }}
        <p class="ui-note">Runs are completed / started. "Last run activity" is the latest run start or received completion. Sign-ins are not recorded.</p>
    </div>
{% endblock %}
