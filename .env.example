# Database Configuration
POSTGRES_DB=monad_db
POSTGRES_USER=monad_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_PORT=5432
DB_HOST=postgres

# Symfony API Configuration
SYMFONY_PORT=8000
APP_ENV=dev
APP_SECRET=your_app_secret_here

# JWT Configuration
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=your_jwt_passphrase_here

# Nuxt Frontend Configuration
NUXT_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# Router base for absolute URLs generated outside a request (console, API docs)
DEFAULT_URI=https://api.monad.dubec.dev

# CORS Configuration
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# Object storage — Hetzner Object Storage (S3-compatible). No AWS anywhere in this project.
# The bucket is the project's, shared with the csid fleet captures and simulation artefacts, so a
# phone session lands in the same tenancy as the radio capture it must be joined to.
# HETZNER_S3_ENDPOINT is mandatory — there is no default, deliberately: an empty endpoint used to
# mean "talk to Amazon", and that is exactly the sort of default that ships research data to the
# wrong provider unnoticed. Path-style addressing is required because Hetzner issues no wildcard
# certificate for virtual-hosted bucket names.
HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_S3_USE_PATH_STYLE=1
HETZNER_S3_REGION=fsn1
HETZNER_S3_BUCKET=monad-knowledge
HETZNER_S3_ACCESS_KEY=your_hetzner_s3_access_key
HETZNER_S3_SECRET_KEY=your_hetzner_s3_secret_key
HETZNER_S3_PRESIGNED_URL_EXPIRY=+15 minutes
